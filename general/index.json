{"version":3,"kind":"Article","sha256":"98ab71941b2a7d42f85ea3b634f92f99741a828b1cc2d1864a0829e06d481521","slug":"index","location":"/intro.md","dependencies":[],"frontmatter":{"title":"Introduction","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Ib Hansen","given":"Ib","family":"Hansen"},"name":"Ib Hansen","id":"contributors-deploy\\books\\suplement\\general\\myst-generated-uid-0"}],"exports":[{"format":"md","filename":"intro.md","url":"/general/build/intro-43992ca6d571dfd400c0a5503ea9ec9b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"This is a draft","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OhzRMKHpLN"}],"key":"PnN3SucCsN"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This supplement is a ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nOBRxkiRPD"},{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"work in progress","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ASSFLPyJ3S"}],"key":"taLKPasqxD"},{"type":"text","value":". It is circulated to be read and argued with,\nnot as a finished account.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"qgj443jN3C"}],"key":"yP2ziCjOm5"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Comments, corrections and suggestions are very welcome — on the substance, on the\nhistory, or on anything that is unclear, wrong or missing.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Acv7ukR68L"}],"key":"JIk5DpaHnr"}],"key":"s0PZS6excZ"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"This supplement is about ","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"z0ai4TP2sw"},{"type":"strong","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"how ModelFlow is put together","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"SutNa07YaU"}],"key":"BJwhMl95lC"},{"type":"text","value":" — what happens between an\neconomic equation written by a modeller and a number produced by a solver, and why the\nchain is arranged the way it is.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"fFGCMfzOrg"}],"key":"CnVDKcTXHN"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The guiding principle is a division of labour:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"VvmWM5qigI"}],"key":"XHJM1N0gDO"},{"type":"blockquote","position":{"start":{"line":17,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Use Python syntax wherever possible, transform only the notation specific to economic\nmodelling, and delegate the general language and numerical machinery to Python and its\nscientific libraries.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"O0SqIi6Hu9"}],"key":"c7xQC4ia5w"}],"key":"UHaFuVaGE8"}],"key":"Qm3w9iUlYO"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"ModelFlow therefore does not implement an expression language, a compiler, a sparse\nlinear algebra package or a graph library. It implements the part that is specific to\neconomic models — lags and leads, endogenous and exogenous variables, add factors,\nnormalization, dimensional expansion — and generates ordinary Python for everything else.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"akqzjqxclr"}],"key":"sbP7lIj7VC"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"What is in this book","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"DTgv6sm95f"}],"identifier":"what-is-in-this-book","label":"What is in this book","html_id":"what-is-in-this-book","implicit":true,"key":"i6CikwvAfk"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"The four chapters follow one chain, and are ordered so that each takes over where the\nlast leaves off.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"yItVUCLsUB"}],"key":"HB6ofHFM44"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"link","url":"/historic-complete","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Historical background","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"np2Hc4omGG"}],"urlSource":"Historic_complete.md","dataUrl":"/historic-complete.json","internal":true,"protocol":"file","key":"nOf02JcP2F"}],"key":"p0tJX0Bg2I"},{"type":"text","value":" comes first because it explains why the\nrest looks as it does. The same architecture was used on a UNIVAC 1100 mainframe around\n1983 to move the ADAM model from TSP into Danmarks Nationalbank’s NASS, and again in PCIM\nfrom 1985, which put ADAM on a PC with 640 KB of memory and an 8087 coprocessor.\nModelFlow, begun around 2013 for an unrelated problem — unmaintainable bank stress-test\nmodels in Excel — re-derived it a third time. The chapter also notes that the approach is\nnot unique to ModelFlow: Dynare and Project LINK arrived at much the same arrangement\nindependently.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kAxK9LQTEP"}],"key":"XCXckZpnN1"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"link","url":"/modelflow-specification-to-code","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Specification to executable code","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"tQhHkvzWkc"}],"urlSource":"modelflow_specification_to_code.md","dataUrl":"/modelflow-specification-to-code.json","internal":true,"protocol":"file","key":"b38M6jQke9"}],"key":"N9WYZnIojR"},{"type":"text","value":" takes the\ntranslation side. The higher-level DSL of lists, ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"TX73ozROff"},{"type":"inlineCode","value":"do","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"rBJqWIBsc7"},{"type":"text","value":", ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"ZLCqv005nI"},{"type":"inlineCode","value":"doable","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"OrAxBU6UJQ"},{"type":"text","value":" and ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"E7rJImuKHk"},{"type":"inlineCode","value":"sum","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"hdTlsJaYt1"},{"type":"text","value":"; the\npreprocessors that bring in models from other systems; normalization into ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"JhZfsQDXRm"},{"type":"inlineCode","value":"y = F(y, x)","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"GIOevEaSuM"},{"type":"text","value":"\nform together with the add-factor, exogenizable and fitted variants; syntax validation\nagainst the equation the modeller actually wrote; the token rewriting that turns variable\nnames into array positions; and compilation with ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"SXHyZOLT0W"},{"type":"inlineCode","value":"exec","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"hBD6Ze75aX"},{"type":"text","value":" or Numba.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"mQVkCHofKa"}],"key":"I8CXJC4wqP"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"strong","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"link","url":"/modelflow-structure-and-solution","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Structure and solution","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"R1Gz9v4LeI"}],"urlSource":"modelflow_structure_and_solution.md","dataUrl":"/modelflow-structure-and-solution.json","internal":true,"protocol":"file","key":"v0IIJ6Sky4"}],"key":"DbOny8Pn3c"},{"type":"text","value":" starts from the\nexecutable equations and asks how to order and solve them. The dependency graph, its\ndecomposition into prolog, simultaneous core and epilog, and the feedback vertex set that\nshrinks the problem that remains — then the solvers that use all of it: Gauss-Seidel,\nNewton, Newton reduced to the feedback variables, and stacked Newton when leads couple\nthe periods together.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"TRjWUOwzSD"}],"key":"UTkAXBdRDO"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"strong","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"link","url":"/modelflow-stability","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Local stability and dynamics","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"xqg6ypl09M"}],"urlSource":"modelflow_stability.md","dataUrl":"/modelflow-stability.json","internal":true,"protocol":"file","key":"O5mmy8Uh1Q"}],"key":"peWK3ECsAz"},{"type":"text","value":" turns the derivative machinery\nto a different purpose. The Jacobian built for a Newton step is a linearization, and it\ncan be analysed instead of iterated on: contemporaneous effects solved out, lags assembled\ninto a companion matrix, and its eigenvalues used to ask whether small disturbances decay,\noscillate or grow.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"kzPbysTNyV"}],"key":"GTq29prORk"},{"type":"heading","depth":2,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"How to read it","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"E4pB9xDRwP"}],"identifier":"how-to-read-it","label":"How to read it","html_id":"how-to-read-it","implicit":true,"key":"EydZ0Tv7t5"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"The history stands on its own and can be skipped by anyone who only wants to know how the\nsystem works today. The three technical chapters are meant to be read in order — the\nsecond begins from the executable equations the first produces, and the third from the\nJacobian the second builds — but each states its own starting point, so they can also be\nconsulted separately.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"RYWkq7kCfg"}],"key":"gFLn59PEjg"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Two conventions are worth flagging. Generated code is treated throughout as an\nimplementation detail that the modeller is not expected to read; where it appears, it is\nto show what the translation produces, not because anyone works at that level. And claims\nabout what the software does are meant to describe what it actually does — where something\nis an intention rather than a tested capability, it is marked as such.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"hEBsQlmlA1"}],"key":"ZUT9HcGgL3"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Readers interested in the specification language itself — the DSL, the ","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"IjPwWZEbFs"},{"type":"inlineCode","value":"%%Makemymodel","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Bcs3no9VjT"},{"type":"text","value":"\nmagic, normalization and add factors in practical detail — will find them in the companion\nsupplement on model specification.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"AmfNoeqrvJ"}],"key":"BEPv2JBJih"}],"key":"u6dnkqT04y"}],"key":"Wmcmra5niH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Historical Background: From MACRO and PCIM to ModelFlow","short_title":"Historical background","url":"/historic-complete","group":"ModelFlow - Architecture and History"}}},"domain":"http://localhost:3001"}